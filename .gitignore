# ---- Unity ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never ignore .meta files: Unity uses them to keep asset references stable.
!*.meta

# Generated by the editor, not authored by us.
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Keep the hand-written tooling projects, which the rule above would sweep up.
!tools/**/*.csproj
!tools/**/*.sln

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Built players
*.apk
*.aab
*.unitypackage
*.app

# ---- .NET / tooling ----
bin/
[Oo]bj/
.vs/
.vscode/
*.nupkg
TestResults/

# ---- OS ----
.DS_Store
Thumbs.db
